{
  "name": "packet-clash",
  "version": "0.3.0",
  "private": true,
  "description": "Packet Clash — a creature-battler that teaches computer networks",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
